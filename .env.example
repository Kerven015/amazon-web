# Copy to .env.local and fill in. Everything here is read on the server only (never sent to the browser).

# Admin panel login (/admin). In production the server REFUSES TO START unless ADMIN_PASSWORD is
# at least 16 characters and not a placeholder. Make one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Changing ADMIN_PASSWORD (or the secret) logs out every admin session.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 32+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# PostgreSQL on this server (see deploy/postgres-setup.md). Only 127.0.0.1 — never expose port 5432.
# The running site uses vendora_app (can only read/write rows; no DROP/ALTER):
DATABASE_URL=postgres://vendora_app:CHANGE_ME@127.0.0.1:5432/vendora
# `npm run db:migrate` (and db:seed) use vendora_owner, which owns the tables:
MIGRATION_DATABASE_URL=postgres://vendora_owner:CHANGE_ME_TOO@127.0.0.1:5432/vendora

# Security tests (`npm test`) — a SEPARATE database whose name contains "test"; it gets wiped.
# TEST_DATABASE_URL=postgres://vendora_app:CHANGE_ME@127.0.0.1:5432/vendora_test
# TEST_MIGRATION_DATABASE_URL=postgres://vendora_owner:CHANGE_ME_TOO@127.0.0.1:5432/vendora_test

# Order limits while payment is a demo (defaults shown)
# ORDER_MAX_OPEN=3       # orders still waiting to be packed, per customer
# ORDER_MAX_PER_DAY=10   # orders per customer in 24 hours
# ORDER_MAX_UNITS=50     # items in one order (and at most 10 of one size/colour)

# "Continue with Google" + One Tap (optional — see deploy/google-sign-in.md). Public value; no secret needed.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional
# PORT=3000            # production server port
# Visitor IPs for rate limits behind a reverse proxy (nginx, Caddy…):
#   (unset)  trust X-Forwarded-For only from a proxy on this same machine (127.0.0.1 / ::1) — right for most setups
#   1        always trust it (proxy on another machine/container; it must overwrite X-Forwarded-For)
#   0        never trust it (the app is reached directly, no proxy)
# TRUST_PROXY=1
# PUBLIC_ORIGIN=https://shop.example.com  # used for absolute URLs (sitemap) instead of the request's Host header
# CORS_ORIGINS=https://admin.example.com  # other origins allowed to call /api with cookies (comma separated; default: none)
# DATA_DIR=data        # folder that holds products.json (seed data for `npm run db:seed`)
# DATABASE_POOL_SIZE=10  # max PostgreSQL connections the site keeps open
# DEV_EXPOSE=1        # let other devices / VS Code port forwarding / tunnels reach `npm run dev` (off by default;
#                      # set it in the terminal, e.g. `DEV_EXPOSE=1 npm run dev`, and keep tunnels Private)
# DEV_ALLOWED_HOSTS=my-tunnel.example.com   # extra host names the dev server answers to (comma separated)
# COOKIE_SECURE=1      # force Secure cookies outside production (already on with NODE_ENV=production / https)
# UPLOAD_DIR=public/images/products

# Used only by scripts/fetch-product-images.ts
PEXELS_API_KEY=
