# Copy to .env.local and fill in. Everything here is read on the server only (never sent to the browser).

# Admin panel login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 32+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# PostgreSQL on this server (see deploy/postgres-setup.md). Only 127.0.0.1 — never expose port 5432.
# The running site uses vendora_app (can only read/write rows; no DROP/ALTER):
DATABASE_URL=postgres://vendora_app:CHANGE_ME@127.0.0.1:5432/vendora
# `npm run db:migrate` (and db:seed) use vendora_owner, which owns the tables:
MIGRATION_DATABASE_URL=postgres://vendora_owner:CHANGE_ME_TOO@127.0.0.1:5432/vendora

# "Continue with Google" + One Tap (optional — see deploy/google-sign-in.md). Public value; no secret needed.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional
# PORT=3000            # production server port
# TRUST_PROXY=1        # behind ONE proxy/CDN: use the last X-Forwarded-For entry (the one the proxy adds) for rate limits
# PUBLIC_ORIGIN=https://shop.example.com  # used for absolute URLs (sitemap) instead of the request's Host header
# CORS_ORIGINS=https://admin.example.com  # other origins allowed to call /api with cookies (comma separated; default: none)
# DATA_DIR=data        # folder that holds products.json (seed data for `npm run db:seed`)
# DATABASE_POOL_SIZE=10  # max PostgreSQL connections the site keeps open
# COOKIE_SECURE=1      # force Secure cookies outside production (already on with NODE_ENV=production / https)
# UPLOAD_DIR=public/images/products

# Used only by scripts/fetch-product-images.ts
PEXELS_API_KEY=
